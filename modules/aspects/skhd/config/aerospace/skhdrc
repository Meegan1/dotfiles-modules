cmd + shift - 5 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 5; aerospace space --focus 5; aerospace window --focus $window; sketchybar --trigger space_windows_change
cmd + shift - 6 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 6; aerospace space --focus 6; aerospace window --focus $window; sketchybar --trigger space_windows_change
cmd + shift - 7 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 7; aerospace space --focus 7; aerospace window --focus $window; sketchybar --trigger space_windows_change
cmd + shift - 8 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 8; aerospace space --focus 8; aerospace window --focus $window; sketchybar --trigger space_windows_change
cmd + shift - 9 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 9; aerospace space --focus 9; aerospace window --focus $window; sketchybar --trigger space_windows_change
cmd + shift - 0 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 10; aerospace space --focus 10; aerospace window --focus $window; sketchybar --trigger space_windows_change

## Swap spaces
spacemode < shift - h ; default : aerospace swap left; sketchybar --trigger space_windows_change; sketchybar --trigger space_change
spacemode < shift - l ; default : aerospace swap right; sketchybar --trigger space_windows_change; sketchybar --trigger space_change

## focus space #
windowmode, spacemode < 1 ; default : aerospace workspace 1
windowmode, spacemode < 2 ; default : aerospace workspace 2
windowmode, spacemode < 3 ; default : aerospace workspace 3
