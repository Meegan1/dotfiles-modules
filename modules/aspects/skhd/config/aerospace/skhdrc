# create a modal keybinding to activate windowmode
:: windowmode
ctrl - s ; windowmode
windowmode < escape ; default

# space commands
## create space modal
:: spacemode
alt - s ; spacemode
spacemode < escape ; default

cmd - h ; default : aerospace focus --boundaries all-monitors-outer-frame left
cmd - j ; default : aerospace focus --boundaries all-monitors-outer-frame down
cmd - k ; default : aerospace focus --boundaries all-monitors-outer-frame up
cmd - l ; default : aerospace focus --boundaries all-monitors-outer-frame right

cmd +  shift - h ; default : aerospace swap left
cmd +  shift - j ; default : aerospace swap down
cmd +  shift - k ; default : aerospace swap up
cmd +  shift - l ; default : aerospace swap right

# resize windows
spacemode < h : aerospace resize width -20
spacemode < j : aerospace resize height +20
spacemode < k : aerospace resize height -20
spacemode < l : aerospace resize width +20

# toggle window float
windowmode < t ; default : aerospace layout tiling floating

# toggle window fullscreen
windowmode < f ; default : aerospace fullscreen

# balance windows
windowmode < b ; default : aerospace balance-sizes

cmd + shift - 1 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 1; aerospace space --focus 1; aerospace window --focus $window; sketchybar --trigger space_windows_change
cmd + shift - 2 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 2; aerospace space --focus 2; aerospace window --focus $window; sketchybar --trigger space_windows_change
cmd + shift - 3 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 3; aerospace space --focus 3; aerospace window --focus $window; sketchybar --trigger space_windows_change
