# create a modal keybinding to activate windowmode
:: windowmode
ctrl - s ; windowmode
windowmode < escape ; default

# space commands
## create space modal
:: spacemode
alt - s ; spacemode
spacemode < escape ; default

cmd - h : skhd -k "escape"; aerospace focus --boundaries all-monitors-outer-frame left
cmd - j : skhd -k "escape"; aerospace focus --boundaries all-monitors-outer-frame down
cmd - k : skhd -k "escape"; aerospace focus --boundaries all-monitors-outer-frame up
cmd - l : skhd -k "escape"; aerospace focus --boundaries all-monitors-outer-frame right

cmd +  shift - h : skhd -k "escape"; aerospace swap left
cmd +  shift - j : skhd -k "escape"; aerospace swap down
cmd +  shift - k : skhd -k "escape"; aerospace swap up
cmd +  shift - l : skhd -k "escape"; aerospace swap right

# resize windows
spacemode < h : aerospace resize width -20
spacemode < j : aerospace resize height +20
spacemode < k : aerospace resize height -20
spacemode < l : aerospace resize width +20

# toggle window float
windowmode < t : skhd -k "escape"; aerospace layout tiling floating

# toggle window fullscreen
windowmode < f : skhd -k "escape"; aerospace fullscreen

# balance windows
windowmode < b : skhd -k "escape"; aerospace balance-sizes

cmd + shift - 1 : window=$(aerospace list-windows --focused --json | jq '.[0]."window-id"'); aerospace move-node-to-workspace 1; aerospace space --focus 1; aerospace window --focus $window; sketchybar --trigger space_windows_change
